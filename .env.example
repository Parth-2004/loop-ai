# Copy to .env and fill in. Never commit .env.

# ---------- Core ----------
PORT=3000
# Public URL of the app. On Render this is auto-detected (RENDER_EXTERNAL_URL).
APP_URL=http://localhost:3000
# Local default: a SQLite file (no setup needed). On Render the blueprint injects PostgreSQL.
# Any Postgres URL works too: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./loop_ai.db
# Set to true for hosted Postgres that requires SSL (Neon, Supabase, Render external URL)
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-another-long-random-string

# ---------- Gemini (https://aistudio.google.com/apikey) ----------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Used automatically when the main text model is overloaded or out of quota (separate quota)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# gemini-2.5-flash-image  or  imagen-4.0-generate-001
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# veo-3.0-fast-generate-001  or  veo-3.0-generate-001
GEMINI_VIDEO_MODEL=veo-3.0-fast-generate-001

# ---------- Email: approval emails ----------
# Option A (recommended on Render): Resend HTTP API — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Loop AI <onboarding@resend.dev>
# Option B: SMTP (e.g. Gmail with an App Password: smtp.gmail.com / 465 / SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- Social apps ----------
# Redirect URIs to register in each developer portal:
#   X:         {APP_URL}/api/oauth/x/callback
#   LinkedIn:  {APP_URL}/api/oauth/linkedin/callback
#   Meta:      {APP_URL}/api/oauth/meta/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ---------- Worker ----------
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60
